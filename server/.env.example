# Copy to .env and fill in. `npm start` loads it automatically (node --env-file).

# Port the HTTP + WebSocket server listens on.
PORT=3000

# Any string you choose. Paste the same value into
# Meta App Dashboard -> Webhooks -> Page -> "Verify token".
VERIFY_TOKEN=change-me-to-a-random-string

# Meta App Dashboard -> App settings -> Basic -> App secret.
# Used to check the X-Hub-Signature-256 header on every webhook POST.
# If left empty, signature checking is SKIPPED (local testing only!).
APP_SECRET=

# Page access token for the Facebook Page that owns the lead form
# (needs leads_retrieval + pages_manage_metadata + pages_show_list +
# pages_read_engagement + ads_management). Used to fetch lead details.
PAGE_ACCESS_TOKEN=

# Graph API version used for the lead-details fetch.
GRAPH_VERSION=v25.0

# Set to 1 to skip the real Graph API call and return fake field_data.
# Handy with scripts/simulate-webhook.js when you have no Meta setup.
MOCK_GRAPH=0
