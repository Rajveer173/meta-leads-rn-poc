# Base URL of the server (no trailing slash). The app derives the WebSocket
# URL from it: https:// -> wss://  and  http:// -> ws://
#
# Public tunnel (same URL you gave Meta, minus /webhook):
# EXPO_PUBLIC_API_URL=https://your-subdomain.trycloudflare.com
#
# Or the server on your LAN (phone and PC on the same Wi-Fi; use your PC's IPv4
# from `ipconfig`, not localhost):
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
